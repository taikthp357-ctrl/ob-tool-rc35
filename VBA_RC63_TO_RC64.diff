+ If mEDCLastDueDeficits Is Nothing Then
+  Set EDC4007_GetDueDeficits = CreateObject("Scripting.Dictionary")
+ Else
+  Set EDC4007_GetDueDeficits = mEDCLastDueDeficits
+ End If
 End Function
 
