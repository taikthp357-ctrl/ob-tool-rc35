+' RC64: Danh gia so luong STO Due da giam ngay tren man hinh sau khi F8 Refresh
+Public Function EDC4007_EvaluateDueDecrease(ByVal sto As String) As Object
+Dim deficits As Object, mat As Variant, planned As Variant, cand As Variant
+Dim initialDue As Double, requestedQty As Double, remainingDue As Double, consumedQty As Double, deficit As Double
+Dim newDueCol As Collection, found As Boolean
+
+Set deficits = CreateObject("Scripting.Dictionary")
+Set mEDCLastDueDeficits = CreateObject("Scripting.Dictionary")
+
+If mEDCGroupTargets Is Nothing Or mEDCGroupDue Is Nothing Then
+ Set EDC4007_EvaluateDueDecrease = deficits
+ Exit Function
+End If
+
+On Error GoTo EvaluateFailed
+Set newDueCol = EDC4007_ReadDueCurrentScreen(sto)
+
+For Each mat In mEDCGroupTargets.keys
+ planned = mEDCGroupTargets(mat)
+ initialDue = 0#
+ If mEDCGroupDue.exists(CStr(mat)) Then
+  initialDue = CDbl(mEDCGroupDue(CStr(mat))(4))
+ End If
+ requestedQty = CDbl(planned(3))
+ 
+ ' Find matching row in refreshed Due list
+ found = False
+ remainingDue = 0#
+ If Not newDueCol Is Nothing Then
+  For Each cand In newDueCol
+   If CStr(cand(0)) = sto And val(CStr(cand(1))) = val(CStr(planned(2))) And CStr(cand(2)) = CStr(mat) Then
+    remainingDue = CDbl(cand(4))
+    found = True
+    Exit For
+   End If
+  Next cand
+ End If
+ 
+ If Not found Then
+  ' Dong da bien mat khoi Due List -> Open Qty ve 0, STO da giam toan bo!
+  remainingDue = 0#
+  consumedQty = initialDue
+ Else
+  consumedQty = initialDue - remainingDue
+ End If
+ 
+ If consumedQty >= requestedQty Then
+  deficit = 0#
+  ModuleLog.WriteLog "VL10D_STO_DUE_CONSUMED", "Material=" & CStr(mat) & "; STO=" & sto & "/" & CStr(planned(2)) & "; initialDue=" & initialDue & "; newDue=" & remainingDue & "; consumed=" & consumedQty & "; requested=" & requestedQty & " -> DONE (STO decreased fully)"
+ Else
+  deficit = requestedQty - IIf(consumedQty > 0#, consumedQty, 0#)
+  deficits(CStr(mat)) = deficit
+  ModuleLog.WriteLog "VL10D_STO_DUE_UNCHANGED", "Material=" & CStr(mat) & "; STO=" & sto & "/" & CStr(planned(2)) & "; initialDue=" & initialDue & "; newDue=" & remainingDue & "; consumed=" & consumedQty & "; requested=" & requestedQty & " -> DEFICIT=" & deficit & " (STO did not decrease, 3001 holding stock)"
+ End If
+Next mat
+
+Set mEDCLastDueDeficits = deficits
+Set EDC4007_EvaluateDueDecrease = deficits
+Exit Function
+
+EvaluateFailed:
+ ModuleLog.WriteLog "VL10D_EVALUATE_DUE_ERR", Err.Number & "; " & Err.Description
+ Set EDC4007_EvaluateDueDecrease = deficits
+End Function
+
