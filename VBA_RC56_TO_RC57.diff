+Private Sub ClearConfigPrefix(ByVal prefix As String)
+Dim ws As Worksheet, r As Long
+Set ws = ThisWorkbook.Worksheets("CONFIG")
+For r = 2 To ws.Cells(ws.rows.count, 1).End(xlUp).row
+ If Left$(CStr(ws.Cells(r, 1).Value2), Len(prefix)) = prefix Then
+  ws.Cells(r, 2).Value2 = ""
+ End If
+Next r
+End Sub
+
+Private Sub EDCReconcileInputNotes(ByVal scope As String)
+Dim ws As Worksheet, r As Long, mat As String, need As Double, cap As Double
+Set ws = ThisWorkbook.Worksheets("INPUT")
+For r = 6 To 205
+ mat = Trim$(CStr(ws.Cells(r, 1).Value2))
+ If mat <> "" Then
+  need = EDCRequestQty(mat)
+  If need > 0 Then
+   cap = EDCExistingCapacity(mat, scope)
+   If cap >= need Then
+    ' VERIFIED_FULL: Bao toan ghi chu cot D, khoa trang thai
+    If InStr(1, CStr(ws.Cells(r, 4).Value2), "DONE", vbTextCompare) = 0 And _
+       InStr(1, CStr(ws.Cells(r, 4).Value2), "VERIFIED_FULL", vbTextCompare) = 0 Then
+     ws.Cells(r, 4).Value2 = "VERIFIED_FULL: Da co OB " & cap & "/" & need & " pcs"
+    End If
+   ElseIf cap > 0 Then
+    ws.Cells(r, 4).Value2 = "DA CO OB " & cap & " pcs; THIEU " & (need - cap) & " pcs"
+   Else
+    ws.Cells(r, 4).ClearContents
+   End If
+  Else
+   ws.Cells(r, 4).ClearContents
+  End If
+ Else
+  ws.Cells(r, 4).ClearContents
+ End If
+Next r
+End Sub
