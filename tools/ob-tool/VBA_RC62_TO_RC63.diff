+Public Function SAPX_CheckDeliveryStatus(ByVal ob As String, Optional ByVal sesIn As Object = Nothing) As String
+    Dim fld As Object, sText As String, sType As String
+    Dim wndTitle As String
+    Dim ses As Object
+    On Error GoTo ErrHandler
+    
+    If Trim$(ob) = "" Then
+        SAPX_CheckDeliveryStatus = "INVALID_OB"
+        Exit Function
+    End If
+    
+    If Not sesIn Is Nothing Then
+        Set ses = sesIn
+    Else
+        Set ses = SAPX_GetSessionForTcode("VL03N")
+    End If
+    
+    If ses Is Nothing Then
+        SAPX_CheckDeliveryStatus = "NO_SESSION"
+        Exit Function
+    End If
+    
+    SAPX_Navigate ses, "VL03N"
+    If Not SAPX_WaitIdle(ses, 15) Then
+        SAPX_CheckDeliveryStatus = "NAV_TIMEOUT"
+        Exit Function
+    End If
+    
+    Set fld = SAPX_FindById(ses, "wnd[0]/usr/ctxtLIKP-VBELN")
+    If fld Is Nothing Then Set fld = DeliveryNumberField(ses)
+    If fld Is Nothing Then
+        SAPX_CheckDeliveryStatus = "FIELD_NOT_FOUND"
+        Exit Function
+    End If
+    
+    fld.text = ob
+    ses.findById("wnd[0]").sendVKey 0
+    If Not SAPX_WaitIdle(ses, 15) Then
+        SAPX_CheckDeliveryStatus = "TIMEOUT"
+        Exit Function
+    End If
+    
+    sText = SAPX_StatusText(ses)
+    sType = SAPX_StatusType(ses)
+    
+    ' Check if delivery does not exist (not in DB or archive)
+    If InStr(1, sText, "does not exist", vbTextCompare) > 0 Or _
+       InStr(1, sText, "nicht vorhanden", vbTextCompare) > 0 Or _
+       InStr(1, sText, "khong ton tai", vbTextCompare) > 0 Then
+        ModuleLog.WriteLog "VL03N_CHECK_NOT_FOUND", "Delivery " & ob & " does not exist: " & sText, ob
+        SAPX_CheckDeliveryStatus = "NOT_FOUND"
+        Exit Function
+    End If
+    
+    ' Check if delivery is locked
+    If InStr(1, sText, "is currently being processed by", vbTextCompare) > 0 Or _
+       InStr(1, sText, "wird bereits von", vbTextCompare) > 0 Or _
+       InStr(1, sText, "locked", vbTextCompare) > 0 Or _
+       InStr(1, sText, "gesperrt", vbTextCompare) > 0 Then
+        ModuleLog.WriteLog "VL03N_CHECK_LOCKED", "Delivery " & ob & " is locked: " & sText, ob
+        SAPX_CheckDeliveryStatus = "LOCKED"
+        Exit Function
+    End If
+    
+    If sType = "E" Then
+        ModuleLog.WriteLog "VL03N_CHECK_ERROR", "Delivery " & ob & " check error: " & sText, ob
+        SAPX_CheckDeliveryStatus = "ERROR: " & sText
+        Exit Function
+    End If
+    
+    wndTitle = ""
+    On Error Resume Next
+    wndTitle = CStr(ses.findById("wnd[0]").text)
+    On Error GoTo ErrHandler
+    
+    If InStr(1, wndTitle, "Display Outbound Delivery", vbTextCompare) > 0 Or _
+       InStr(1, wndTitle, "Outbound Delivery", vbTextCompare) > 0 Or _
+       InStr(1, wndTitle, "Lieferung anzeigen", vbTextCompare) > 0 Or _
+       Not DeliveryOverview(ses) Is Nothing Then
+        ModuleLog.WriteLog "VL03N_CHECK_EXISTS", "Delivery " & ob & " verified exists in SAP", ob
+        SAPX_CheckDeliveryStatus = "EXISTS"
+        Exit Function
+    End If
+    
+    SAPX_CheckDeliveryStatus = "UNKNOWN"
+    Exit Function
+    
+ErrHandler:
+    ModuleLog.WriteLog "VL03N_CHECK_EXCEPTION", ob & "; " & Err.Description, ob
