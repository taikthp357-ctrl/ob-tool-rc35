+' =========================================================================
+' RC62: THUAT TOAN TOI UU HOA LUA CHON TO HOP OB CAN XOA (SUBSET-SUM)
+' Uu tien xoa vua du; neu khong the vua du thi chon to hop OB co tong Qty vuot nhu cau it nhat.
+' =========================================================================
+Private Sub BacktrackSubset(ByRef arrQty() As Double, ByRef suffixSums() As Double, ByVal n As Long, _
+                            ByVal needQty As Double, ByVal idx As Long, ByVal currentSum As Double, _
+                            ByRef curIndices() As Long, ByVal curCount As Long, _
+                            ByRef bestSurplus As Double, ByRef bestCount As Long, _
+                            ByRef bestIndices() As Long, ByRef bestIdxCount As Long)
+    Dim surplus As Double: surplus = currentSum - needQty
+    If surplus >= 0# Then
+        If (surplus < bestSurplus) Or (surplus = bestSurplus And curCount < bestCount) Then
+            bestSurplus = surplus
+            bestCount = curCount
+            bestIdxCount = curCount
+            Dim k As Long
+            For k = 0 To curCount - 1
+                bestIndices(k) = curIndices(k)
+            Next k
+        End If
+        Exit Sub
+    End If
+    
+    If currentSum + suffixSums(idx) < needQty Then Exit Sub
+    
+    Dim i As Long, q As Double, newSurplus As Double
+    For i = idx To n - 1
+        q = arrQty(i)
+        newSurplus = (currentSum + q) - needQty
+        If newSurplus >= 0# And newSurplus > bestSurplus Then
+            ' Bo qua nhanh nay neu surplus da lon hon bestSurplus
+        Else
+            curIndices(curCount) = i
+            BacktrackSubset arrQty, suffixSums, n, needQty, i + 1, currentSum + q, _
+                            curIndices, curCount + 1, bestSurplus, bestCount, bestIndices, bestIdxCount
+            If bestSurplus = 0# And bestCount = 1 Then Exit Sub
+        End If
+    Next i
+End Sub
+
+Private Function OptimalOBSubset(ByVal candOBs As Collection, ByVal candQtys As Collection, ByVal needQty As Double) As Collection
+    Dim n As Long: n = candOBs.count
+    Set OptimalOBSubset = New Collection
+    If n = 0 Then Exit Function
+    
+    Dim totalAvail As Double, i As Long
+    For i = 1 To n
+        totalAvail = totalAvail + CDbl(candQtys(i))
+    Next i
+    
+    ' Neu tong so luong nho hon hoac bang can thiet, chon toan bo
+    If totalAvail <= needQty Then
+        For i = 1 To n
+            OptimalOBSubset.Add CStr(candOBs(i))
+        Next i
+        Exit Function
+    End If
+    
+    Dim arrOB() As String, arrQty() As Double
+    ReDim arrOB(0 To n - 1), arrQty(0 To n - 1)
+    For i = 0 To n - 1
+        arrOB(i) = CStr(candOBs(i + 1))
+        arrQty(i) = CDbl(candQtys(i + 1))
+    Next i
+    
+    ' Sap xep giam dan theo so luong de toi uu branch-and-bound
+    Dim j As Long, tmpOB As String, tmpQty As Double
+    For i = 0 To n - 2
+        For j = i + 1 To n - 1
+            If arrQty(j) > arrQty(i) Then
+                tmpQty = arrQty(i): arrQty(i) = arrQty(j): arrQty(j) = tmpQty
+                tmpOB = arrOB(i): arrOB(i) = arrOB(j): arrOB(j) = tmpOB
+            End If
+        Next j
+    Next i
+    
+    Dim suffixSums() As Double
+    ReDim suffixSums(0 To n)
+    suffixSums(n) = 0#
+    For i = n - 1 To 0 Step -1
+        suffixSums(i) = suffixSums(i + 1) + arrQty(i)
+    Next i
+    
+    Dim bestSurplus As Double, bestCount As Long
+    bestSurplus = 1E+30: bestCount = 999999
+    Dim bestIndices() As Long, bestIdxCount As Long
+    ReDim bestIndices(0 To n - 1)
+    bestIdxCount = 0
+    Dim curIndices() As Long
+    ReDim curIndices(0 To n - 1)
+    
+    BacktrackSubset arrQty, suffixSums, n, needQty, 0, 0#, curIndices, 0, _
+                    bestSurplus, bestCount, bestIndices, bestIdxCount
+                    
+    If bestIdxCount > 0 Then
+        For i = 0 To bestIdxCount - 1
+            OptimalOBSubset.Add arrOB(bestIndices(i))
+        Next i
+    Else
+        For i = 0 To n - 1
+            OptimalOBSubset.Add arrOB(i)
+        Next i
+    End If
+End Function
