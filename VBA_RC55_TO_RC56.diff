+   Err.Raise vbObjectError + 4215, , "PRESAVE_GATE_FAIL: UNKNOWN_UI_STATE Thieu final Batch Split table"
+  End If
+  ValidateSplitRows ses, batches, sloc, CDbl(planned(1)), ob
