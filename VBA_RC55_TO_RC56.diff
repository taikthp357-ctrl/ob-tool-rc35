+    If qty <= 0 Then Err.Raise vbObjectError + 4269, , "GROUP_OB_LIST_WAIT: invalid list Qty for " & key & "; pending kept; no Create retry."
+    seen.Add key, True: totals(CStr(mat)) = CDbl(totals(CStr(mat))) + qty
    End If
