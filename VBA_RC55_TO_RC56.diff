-If btn Is Nothing Then Err.Raise vbObjectError + 4217, , "Persisted split view unavailable for " & parentItem
-
-btn.Press
-
-If Not SAPX_WaitIdle(ses, 30) Then Err.Raise vbObjectError + 4217, , "Persisted split timeout for " & parentItem
-
-AssertNoPopup ses
