+   ModuleLog.WriteLog "SLOC_FILL", "SplitItem=" & item & "; ChildRow=" & splitRow & "; ExpectedSloc=" & sloc & "; ActualSloc=" & sloc & "; Batch=" & b & "; Qty=" & CDbl(batches(b)), ob
