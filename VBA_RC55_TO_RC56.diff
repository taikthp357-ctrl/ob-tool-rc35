+ModuleLog.WriteLog "SAP_TIMING_V2", "total=" & Format$(SAPX_Elapsed(applyStarted), "0.00") & "; idle_wait=" & Format$(mWaitSeconds, "0.00"), ob
+mMeasureWait = False
