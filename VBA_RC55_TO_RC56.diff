-
             detail = "So dong SAP thay doi trong khi tai: truoc=" & CStr(maxRows) & _
-
                 "; sau=" & CStr(observedRows) & ". SAP: " & POST_SAPReplyText(ses)
 
-
-
             Exit Function
 
-
-
         End If
 
-
-
         If observedRows > maxRows Then
 
-
-
             If observedRows > maxRowsAllowed Then
 
