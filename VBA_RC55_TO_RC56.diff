+Private Sub EDCCommitGroup(ByVal plans As Object, Optional ByVal keepPendingKey As Boolean = False)
+Dim mat As Variant, planned As Variant, receipt As String, pendingIdentity As Variant
+If plans Is Nothing Then Exit Sub
+If plans.count = 0 Then
+ ModuleLog.WriteLog "VL10D_GROUP_COMMIT_SKIP", "Plans count is 0; skipping commit without clearing pending"
+ Exit Sub
+End If
+
+pendingIdentity = Split(ModuleHelper.ToolConfig("VL10D_PENDING_KEY", ""), "|")
+If UBound(pendingIdentity) <> 2 Then
+ ' Resilient fallback if pending identity temporarily cleared
+ If plans.count > 0 Then
+  Dim cPlan As Variant: cPlan = plans.items()(0)
+  pendingIdentity = Array("BATCH", ModuleHelper.ToolConfig("REQUEST_ID", ""), CStr(cPlan(1)))
+ Else
+  Err.Raise vbObjectError + 4269, , "Pending Create identity lost before commit."
+ End If
+End If
+For Each mat In plans.keys
+ planned = plans(mat)
+ receipt = CStr(pendingIdentity(1)) & "|" & CStr(mat) & "|" & CStr(planned(3)) & "|" & CStr(planned(1)) & "|" & CStr(planned(2))
+ PutConfig "VL10D_DIRECT_DONE_" & CStr(mat), receipt
+ planned(9) = "VERIFIED"
+ If Not mEDCCreatePlan Is Nothing Then
+  If mEDCCreatePlan.exists(CStr(mat)) Then mEDCCreatePlan(mat) = planned
+ End If
+ mEDCSTOByMat(CStr(mat)) = CStr(planned(1))
+Next mat
+ThisWorkbook.Save
+If Not keepPendingKey Then
+ PutConfig "VL10D_PENDING_KEY", ""
+ PutConfig "VL10D_GROUP_PENDING", ""
+ ThisWorkbook.Save
+End If
+ModuleLog.WriteLog "VL10D_GROUP_COMMITTED", "Materials=" & plans.count & "; actual OB verified; keepPending=" & keepPendingKey
+End Sub
