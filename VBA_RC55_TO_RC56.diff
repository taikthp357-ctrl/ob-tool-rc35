+ Else
+  ModuleLog.WriteLog "POSTSAVE_VERIFY", "State=AUDIT_TRIGGERED; Reason=AMBIGUOUS_RECEIPT; MsgId=" & msgId & "; MsgNo=" & msgNo & "; OB=" & ob, ob
+ End If
+ postSavePass = PostSaveVerify(ses, ob, itemMap, sloc)
