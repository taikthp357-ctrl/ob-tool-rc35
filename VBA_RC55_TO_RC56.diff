+requiresAudit = (UCase$(Trim$(CStr(ModuleHelper.ToolConfig("STRICT_AUDIT", "FALSE")))) = "TRUE")
+isCleanReceipt = (statusType = "S" And IsSaveReceipt(statusText, ob, ses))
