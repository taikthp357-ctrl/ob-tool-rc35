+Private Function JoinDictKeys(ByVal d As Object) As String
+Dim k As Variant, s As String
+If d Is Nothing Then Exit Function
+For Each k In d.keys
+ s = s & IIf(s <> "", ",", "") & CStr(k)
+Next k
+JoinDictKeys = s
+End Function
